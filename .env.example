# Settings for `docker compose`. Copy to .env and fill in.

# PIN for the /settings page. Pick something other than 1234!
ADMIN_PIN=

# Port on the host the app is published on.
HOST_PORT=3000

# Public address of the app, used for the QR code on the leaderboard.
# PUBLIC_URL=https://challenge.example.com

# Only when the frontend runs on GitHub Pages as well:
# CORS_ORIGIN=https://thomasv-z.github.io
